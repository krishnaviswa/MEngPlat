NEXT_PUBLIC_API_URL=http://localhost:8000
# Required on Railway for home/search SSR. Same value as NEXT_PUBLIC_API_URL
# (backend HTTPS URL, no trailing slash). Without this, the Next container
# falls back to http://localhost:8000 and Featured businesses stays empty.
API_URL_INTERNAL=http://localhost:8000
NEXT_PUBLIC_GOOGLE_MAPS_KEY=placeholder
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

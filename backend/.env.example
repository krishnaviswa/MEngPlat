# Backend environment (copy to backend/.env for local non-Docker use)
DATABASE_URL=postgresql+asyncpg://merchanthub:merchanthub@localhost:5432/merchanthub
REDIS_URL=redis://localhost:6379/0
# Required -- no insecure default. openssl rand -hex 32
SECRET_KEY=dev-secret-key-change-in-production
DEBUG=true

# AI_PROVIDER selects one of: mock (default, no key needed), openai, deepseek,
# groq, gemini, qwen, glm, kimi, anthropic. Unknown values and missing keys
# fail at startup (see app/services/ai/__init__.py:validate_startup_config),
# not on the first request.
AI_PROVIDER=mock
AI_FALLBACK_PROVIDER=mock

# Simplest way to configure whichever provider is active: set these three.
# They apply ONLY to the provider AI_PROVIDER currently names.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# To hold credentials for more than one provider at once (e.g. to switch
# AI_PROVIDER without re-entering a key), use per-provider overrides instead:
#   AI_PROVIDERS__DEEPSEEK__API_KEY=...
#   AI_PROVIDERS__GROQ__API_KEY=...
#   AI_PROVIDERS__GROQ__MODEL=llama-...
# A vendor-native env var also works and is checked before the legacy triple:
# OPENAI_API_KEY, DEEPSEEK_API_KEY, GROQ_API_KEY, GEMINI_API_KEY (or
# GOOGLE_API_KEY), DASHSCOPE_API_KEY (qwen), ZHIPU_API_KEY (glm),
# MOONSHOT_API_KEY (kimi), ANTHROPIC_API_KEY.
# Full precedence order and every base URL/model default: see
# app/services/ai/providers/openai_family.py (SPECS) and
# app/services/ai/provider_config.py.

# EMAIL_PROVIDER selects one of: mock (default, no key needed, logs only) or
# resend. Unknown values and a resend selection missing its key/from fail at
# startup (see app/services/email/__init__.py:validate_startup_config).
EMAIL_PROVIDER=mock
RESEND_API_KEY=
EMAIL_FROM=
# Origin used to build password-reset links in email copy. Not a secret.
PUBLIC_APP_URL=http://localhost:3000

# PAYMENTS_PROVIDER: mock (default, no Razorpay keys) or razorpay.
PAYMENTS_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# SMS_PROVIDER: mock (default, logs OTP) or msg91.
SMS_PROVIDER=mock
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# WhatsApp Cloud API. Compose/CI stay mock. Live cutover: README §14.
WHATSAPP_PROVIDER=mock
WHATSAPP_BUSINESS_NUMBER=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_APP_SECRET=

# Partner review channel (S-123, ADR-019). Only `mock` is registered -- it
# verifies HMAC for real against the demo partner's secret and logs callbacks.
PARTNERS_PROVIDER=mock
# The seeded demo partner's credentials (mock only). The dev billing console
# signs as this partner server-side; the browser never sees the secret.
PARTNER_DEMO_API_KEY=mhk_demo_partner
PARTNER_DEMO_HMAC_SECRET=mhs_demo_partner_secret
PARTNER_REVIEW_TOKEN_TTL_HOURS=336

STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads

# Used only when STORAGE_PROVIDER=s3. Credentials are NOT set here -- boto3
# picks them up from its own default chain (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
# env vars, an IAM role, or ~/.aws/credentials).
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=us-east-1
# Only for S3-compatible services (MinIO, Cloudflare R2, LocalStack).
STORAGE_S3_ENDPOINT_URL=
# Only to front the bucket with a CDN/custom domain; defaults to the bucket's
# own virtual-hosted-style URL when blank.
STORAGE_S3_PUBLIC_BASE_URL=

CORS_ORIGINS=http://localhost:3000
GOOGLE_MAPS_API_KEY=placeholder

# OAuth 2.0 client ID from Google Cloud Console (APIs & Services > Credentials
# > OAuth client ID > Web application). Must match the frontend's
# NEXT_PUBLIC_GOOGLE_CLIENT_ID -- this is the "audience" every Google sign-in
# token is checked against. Not a secret; safe to be public.
GOOGLE_CLIENT_ID=

# Demo seed gate (scripts/seed.py). Default off — safe for production boots.
# Local / Compose: if_outdated. One-shot refresh: force.
# Temporary mock-only Mobile OTP (REMOVE — docs/agents/REMOVE-ME-demo-fixed-otp.md)
DEMO_PHONE_OTP=123456
SEED_MODE=force
SEED_VERSION=2026-08-29-partner-review-channel-v1
SUPPORT_EMAIL=support@merchanthub.example
